{
  "server": "catastro-pro",
  "version": "0.3.1",
  "tools": [
    {
      "name": "catastro_property",
      "title": "catastro property",
      "description": "Retrieve only non-protected cadastral property facts from the official service. No owners, tax identifiers, cadastral valuations or title certification.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          }
        },
        "required": [
          "reference"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "catastro_coordinates",
      "title": "catastro coordinates",
      "description": "Return labelled longitude/latitude in EPSG:4326 from the official cadastral reference point, not a surveyed boundary.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          }
        },
        "required": [
          "reference"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "catastro_ficha",
      "title": "catastro ficha",
      "description": "One-call public cadastral description and coordinate reference point with visible partial failures.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          }
        },
        "required": [
          "reference"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "catastro_pro_demo",
      "title": "Catastro Pro · ejemplo guardado",
      "description": "Read the bundled dated example without network access. It is historical, never live.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "catastro_pro_report",
      "title": "Catastro Pro · informe",
      "description": "Return a deterministic Markdown, HTML or JSON report for one product operation or the saved example. Writes no files; preserve source dates and partial coverage.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "catastro_property",
              "catastro_coordinates",
              "catastro_ficha",
              "catastro_pro_demo"
            ]
          },
          "arguments": {
            "type": "object",
            "default": {}
          },
          "format": {
            "type": "string",
            "enum": [
              "markdown",
              "html",
              "json"
            ],
            "default": "markdown"
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    }
  ]
}
